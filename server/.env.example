# Thor Server Environment Configuration

# Server port
PORT=3001

# Node environment (production disables the permissive dev CORS middleware)
NODE_ENV=development

# Directory containing the React build (index.html + static/).
# In a .deb install this is set to /usr/lib/thor-server/public.
# In dev, point it at ../frontend/build, or use the CRA dev server (which proxies /api → :3001).
PUBLIC_DIR=../frontend/build

# Directory for server log file (server.log is written here)
# Defaults to ./logs in development; set to /var/log/thor-server in production
LOG_DIR=./logs
